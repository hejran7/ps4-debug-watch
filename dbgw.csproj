<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>dbgw</AssemblyName>
    <Prefer32Bit>false</Prefer32Bit>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
    <!-- Keep our own AssemblyInfo.cs instead of letting the SDK auto-generate it -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <LangVersion>7.3</LangVersion>
    <!-- Must match the namespace in code so .resx manifest names resolve correctly -->
    <RootNamespace>debugwatch</RootNamespace>
  </PropertyGroup>

  <!-- Tie each .resx to its code-behind so MSBuild names the resource manifest
       "debugwatch.DebugWatchForm.resources" instead of "dbgw.debugwatch.DebugWatchForm.resources" -->
  <ItemGroup>
    <EmbeddedResource Update="debugwatch\DebugWatchForm.resx">
      <DependentUpon>DebugWatchForm.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="debugwatch\AssemblerView.resx">
      <DependentUpon>AssemblerView.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="debugwatch\MemoryMapView.resx">
      <DependentUpon>MemoryMapView.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Auto-run "dotnet restore" if the assets file is missing (e.g. first build after clone).
       SkipAutoRestore=true is passed into the restore call to prevent infinite recursion,
       since dotnet restore itself invokes MSBuild and would re-trigger this target. -->
  <Target Name="AutoRestore"
          BeforeTargets="CollectPackageReferences"
          Condition="'$(SkipAutoRestore)' != 'true' And !Exists('$(MSBuildProjectDirectory)\obj\project.assets.json')">
    <Exec Command="dotnet restore &quot;$(MSBuildProjectFullPath)&quot; -p:SkipAutoRestore=true" />
  </Target>

  <!-- Stop the SDK from auto-copying the entire lib\ folder to the output directory -->
  <ItemGroup>
    <None Remove="lib\**\*" />
  </ItemGroup>

  <!-- Copy native keystone.dll to the output folder where KeystoneImports expects it.
       Place keystone.dll from https://github.com/keystone-engine/keystone/releases into:
         lib\win64\keystone.dll   (64-bit)
         lib\win32\keystone.dll   (32-bit) -->
  <ItemGroup>
    <None Include="lib\win64\keystone.dll" Condition="Exists('lib\win64\keystone.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>win64\keystone.dll</Link>
    </None>
    <None Include="lib\win32\keystone.dll" Condition="Exists('lib\win32\keystone.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>win32\keystone.dll</Link>
    </None>
  </ItemGroup>

  <!-- Local DLL references — lib\ folder ships alongside the project -->
  <ItemGroup>
    <Reference Include="Be.Windows.Forms.HexBox">
      <HintPath>lib\Be.Windows.Forms.HexBox.dll</HintPath>
    </Reference>
    <Reference Include="SharpDisasm">
      <HintPath>lib\SharpDisasm.dll</HintPath>
    </Reference>
    <Reference Include="libdebug">
      <HintPath>lib\libdebug.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
